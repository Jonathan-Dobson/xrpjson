{
  "name": "xrpjson",
  "version": "1.3.0",
  "description": "Functional transaction factories for the XRP Ledger — 79 frozen-shape builders verified against xrpl.js, xrpl.org, and XLS specs.",
  "type": "module",
  "main": "./dist/fp/index.js",
  "types": "./dist/fp/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/fp/index.js",
      "types": "./dist/fp/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./flags": {
      "import": "./dist/types/flags.js",
      "types": "./dist/types/flags.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "xrp",
    "xrpl",
    "ripple",
    "ledger",
    "blockchain",
    "crypto",
    "transaction",
    "builder",
    "factory",
    "functional",
    "frozen-shape"
  ],
  "author": "Jonathan Dobson",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.6.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.1",
    "xrpl": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-Dobson/xrpjson.git"
  },
  "bugs": {
    "url": "https://github.com/Jonathan-Dobson/xrpjson/issues"
  },
  "homepage": "https://github.com/Jonathan-Dobson/xrpjson#readme"
}
