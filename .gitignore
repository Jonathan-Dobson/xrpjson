# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# codesearch incremental-index bookkeeping. Local only: it is session
# bootstrap state for the agent, and the index itself lives in the Milvus
# volume. Never commit it — tracking it on one branch only means switching
# branches deletes it, and the next incremental reindex then re-upserts
# every file without pruning the stale chunks.
.search-index-state.json

# Output
dist
.vite/

# Env
.env
.env.*
!.env.example

# OS
.DS_Store

# Scratch
scratch/
.worktrees/

# npm cache (this sandbox cannot chown npm's cache dirs, so they land root-owned
# and break later `npm` invocations with EPERM. Keep them out of the repo.)
.npm-cache/

